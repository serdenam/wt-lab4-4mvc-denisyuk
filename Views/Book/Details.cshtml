@model wt_lab4_4mvc_denisyuk.Models.Book

@{
    ViewData["Title"] = "Информация о книге";
}

<div class="container py-4">
    <h2 class="mb-4">Подробная информация</h2>
    <div class="card shadow-sm rounded-4" style="max-width: 600px;">
        <div class="card-body">
            <h4 class="card-title">@Model.Title</h4>
            <hr />
            <p><strong>ID:</strong> @Model.Id</p>
            <p><strong>Автор:</strong> @Model.Author</p>
            <p><strong>Год издания:</strong> @Model.Year</p>
            <p><strong>Статус:</strong> @(Model.IsAvailable ? "Доступна для выдачи" : "Выдана читателю")</p>
            
            <a asp-action="Index" class="btn btn-secondary mt-3">Назад к списку</a>
        </div>
    </div>
</div>
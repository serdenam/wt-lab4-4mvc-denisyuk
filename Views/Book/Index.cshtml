@model List<wt_lab4_4mvc_denisyuk.Models.Book>

@{
    ViewData["Title"] = "Каталог книг";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Каталог книг</h1>
            <p class="text-muted">Система управления библиотекой</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">Добавить книгу</a>
    </div>

    <div class="row g-4">
        @foreach (var book in Model)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm rounded-4">
                    <div class="card-body">
                        <span class="badge bg-secondary mb-2">ID: @book.Id</span>
                        @if (book.IsAvailable)
                        {
                            <span class="badge bg-success mb-2">Доступна</span>
                        }
                        else
                        {
                            <span class="badge bg-danger mb-2">Выдана</span>
                        }
                        <h5 class="card-title">@book.Title</h5>
                        <p class="text-muted mb-1">Автор: @book.Author</p>
                        <p class="fs-5 fw-bold">Год: @book.Year</p>
                        
                        <a asp-action="Details" asp-route-id="@book.Id" class="btn btn-outline-primary mt-2">Подробнее</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>